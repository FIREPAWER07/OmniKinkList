# Copy to .env.local for development. On Netlify, set these under
# Site configuration > Environment variables.

# Database (Postgres).
# Local development: run `bun run db:local` in a separate terminal, then `bun run db:setup` once.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?max=1
# Production (Supabase): Project > Connect > Transaction pooler, with your database password filled in.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Auth. Generate a secret with: openssl rand -base64 32
# The site URL comes from Netlify (or http://localhost:3000 locally), so BETTER_AUTH_URL is not needed.
BETTER_AUTH_SECRET=

# Sign in with Google. Leave empty to hide the button.
# Redirect URL: <site URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Proton, through SimpleLogin (https://app.simplelogin.io/developer).
# Redirect URL: <site URL>/api/auth/callback/simplelogin
# SIMPLELOGIN_CLIENT_ID=
# SIMPLELOGIN_CLIENT_SECRET=

# Email for verification and password reset links and two-factor codes, sent with Resend (https://resend.com).
# Without a key, emails are printed to the server console instead.
# RESEND_API_KEY=
# EMAIL_FROM="OmniKinkList <no-reply@your-domain.com>"

# Cloudflare Turnstile captcha on sign up, sign in, password reset, and suggestions.
# Leave both empty to turn the captcha off (fine for local development).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
