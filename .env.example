# Database. Local development uses a SQLite file; production uses Turso (libsql://...).
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Emails that become admins when they sign up (comma separated).
ADMIN_EMAILS=

# Set to "true" to stop new sign ups once your editors have accounts.
# DISABLE_SIGNUP=true

# Optional social sign in. Leave empty to hide the buttons.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
