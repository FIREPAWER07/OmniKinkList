# Copy to .env.local for development. On Netlify, set these under
# Site configuration > Environment variables.

# Database. Local development uses a SQLite file; production uses Turso (libsql://...).
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Emails that become admins when they sign up (comma separated).
ADMIN_EMAILS=

# Sign in with Google. Leave empty to hide the button.
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Sign in with Proton, through SimpleLogin (https://app.simplelogin.io/developer).
# Redirect URL: <BETTER_AUTH_URL>/api/auth/callback/simplelogin
# SIMPLELOGIN_CLIENT_ID=
# SIMPLELOGIN_CLIENT_SECRET=

# Email for verification and password reset links, sent with Resend (https://resend.com).
# Without a key, emails are printed to the server console instead.
# RESEND_API_KEY=
# EMAIL_FROM="OmniKinkList <no-reply@your-domain.com>"

# Cloudflare Turnstile captcha on sign up, sign in, password reset, and suggestions.
# Leave both empty to turn the captcha off (fine for local development).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Safety switches. Both default to "true"; only turn them off for local testing.
# REQUIRE_EMAIL_VERIFICATION=false
# REQUIRE_EDITOR_2FA=false
